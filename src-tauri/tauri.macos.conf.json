{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Starex",
        "width": 1320,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0d0d0d",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
