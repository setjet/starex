{
  "name": "starex",
  "private": true,
  "version": "0.1.0",
  "description": "A clean, fast launcher for the games on your drive.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && tsc --noEmit",
    "format": "cargo fmt --all",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "lucide-solid": "1.81.0",
    "solid-js": "1.9.20"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.17"
  }
}
